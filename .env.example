# Model
NIGHT_CLERK_MODEL=gemini-3.5-flash

# Google Cloud / Vertex AI contest path
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
NIGHT_CLERK_REGION=us-central1
NIGHT_CLERK_BUCKET=
NIGHT_CLERK_COLLECTION=night_clerk_jobs

# Optional Gemini Developer API path for authorized local testing only.
# Do not commit a real key.
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Local-only dry run (no model, no cloud)
NIGHT_CLERK_MODE=local
